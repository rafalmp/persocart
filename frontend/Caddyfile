{
    auto_https off
    servers {
        protocols h1 h2
    }
}

:80 {
    encode gzip

    # Backend routes — matched first, never fall through to file_server
    handle /api/* {
        reverse_proxy {$BACKEND_URL:http://backend:8000}
    }
    handle /media/* {
        root * /srv
        file_server
    }
    handle /healthz/* {
        reverse_proxy {$BACKEND_URL:http://backend:8000}
    }

    # Everything else — serve SPA, fall back to index.html for client-side routing
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
