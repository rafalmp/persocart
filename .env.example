# Copy to .env and adjust. NEVER commit a real .env. (No real secrets here.)

# ===========================================
# Django
# ===========================================
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Comma-separated, scheme-qualified origins for CSRF (prod), e.g. https://store.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ===========================================
# Database (PostgreSQL 18)
# ===========================================
POSTGRES_DB=persocart
POSTGRES_USER=persocart
POSTGRES_PASSWORD=persocart
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===========================================
# Reverse proxy (production / Phase 5)
# ===========================================
# SITE_ADDRESS=store.example.com
# ACME_EMAIL=admin@example.com
